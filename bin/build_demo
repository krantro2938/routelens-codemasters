#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"

root = File.expand_path("..", __dir__)
ruby = RbConfig.ruby

# Отказы провайдеров здесь НЕ подставлены вручную: seed 210 — обычный
# детерминированный прогон, в котором конверсия из providers.json сама даёт
# пять повторов, два fallback и 100% восстановления. Это важнее подставленного
# fixture: путь отказа виден на тех же данных, что и публичный запуск, и
# demo/resilience_decisions.json проходит validate_10.rb без ошибок.
# Публичный routing_decisions.json остаётся на seed 2026: там повторов нет,
# зато достигается оптимум долей 10.0 п.п. Один seed не может показать оба
# свойства сразу — повтор всегда уводит выплату с целевого провайдера.
commands = [
  [ruby, File.join(root, "bin/route"),
   "--seed", "210",
   "--decisions", File.join(root, "demo/resilience_decisions.json"),
   "--report", File.join(root, "demo/resilience_report.json"), "--quiet"],
  [ruby, File.join(root, "bin/compare_policies"),
   "--output", File.join(root, "demo/policy_comparison.json")],
  [ruby, File.join(root, "bin/observatory"),
   "--decisions", File.join(root, "demo/resilience_decisions.json"),
   "--report", File.join(root, "demo/resilience_report.json"),
   "--comparison", File.join(root, "demo/policy_comparison.json"),
   "--output", File.join(root, "demo/resilience_observatory.html")]
]

commands.each do |command|
  success = system(*command, chdir: root)
  exit 1 unless success
end

puts "Demo package is ready in demo/."
