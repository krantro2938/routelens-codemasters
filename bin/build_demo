#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"

root = File.expand_path("..", __dir__)
ruby = RbConfig.ruby

commands = [
  [ruby, File.join(root, "bin/route"),
   "--outcome-overrides", File.join(root, "test/fixtures/resilience_outcomes.json"),
   "--decisions", File.join(root, "demo/resilience_decisions.json"),
   "--report", File.join(root, "demo/resilience_report.json"), "--quiet"],
  [ruby, File.join(root, "bin/compare_policies"),
   "--output", File.join(root, "demo/policy_comparison.json")],
  [ruby, File.join(root, "bin/observatory"),
   "--decisions", File.join(root, "demo/resilience_decisions.json"),
   "--report", File.join(root, "demo/resilience_report.json"),
   "--comparison", File.join(root, "demo/policy_comparison.json"),
   "--output", File.join(root, "demo/resilience_observatory.html")]
]

commands.each do |command|
  success = system(*command, chdir: root)
  exit 1 unless success
end

puts "Demo package is ready in demo/."
